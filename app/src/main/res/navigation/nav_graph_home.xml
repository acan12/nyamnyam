<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_home"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.beelabs.nyamnyam.ui.activity.home.fragment.HomeFragment"
        android:label="HomeFragment" >
        <action
            android:id="@+id/action_homeFragment_to_orderFragment"
            app:destination="@id/orderFragment" />
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_homeFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
        <action
            android:id="@+id/action_homeFragment_to_updatesFragment"
            app:destination="@id/updatesFragment" />
    </fragment>
    <fragment
        android:id="@+id/orderFragment"
        android:name="com.beelabs.nyamnyam.ui.activity.home.fragment.OrderFragment"
        android:label="OrderFragment" />
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.beelabs.nyamnyam.ui.activity.home.fragment.ProfileFragment"
        android:label="ProfileFragment" />
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.beelabs.nyamnyam.ui.activity.home.fragment.SearchFragment"
        android:label="SearchFragment" />
    <fragment
        android:id="@+id/updatesFragment"
        android:name="com.beelabs.nyamnyam.ui.activity.home.fragment.UpdatesFragment"
        android:label="UpdatesFragment" />
</navigation>