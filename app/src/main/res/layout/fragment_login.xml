<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:src="@drawable/icon_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter_24pt_extra_bold"
            android:text="Sign In" />

    </Toolbar>

    <TextView
        android:id="@+id/tv_title_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen20sp"
        android:fontFamily="@font/inter_24pt_bold"
        android:text="Welcome to"
        android:textColor="@color/black"
        android:textSize="@dimen/dimen25sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <TextView
        android:id="@+id/tv_desc_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimen20sp"
        android:layout_marginTop="20dp"
        android:autoSizeTextType="uniform"
        android:text="Enter your Phone number to get benefit from us. The food provided in here was special flavour for get customers."
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title_login" />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="@dimen/dimen20sp"
        android:background="@drawable/rounded_gray_transparent"
        android:drawableLeft="@drawable/ic_phone_code"
        android:drawablePadding="5dp"
        android:fontFamily="@font/inter_24pt_regular"
        android:hint="Phone Number"
        android:maxLength="15"
        android:maxLines="1"
        android:padding="10dp"
        android:phoneNumber="true"
        android:textColorHint="@color/gray"
        app:layout_constraintTop_toBottomOf="@id/tv_desc_login" />

    <Button
        android:id="@+id/btn_demo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:background="@drawable/rounded_orange_fill_button"
        android:text="Masuk"
        android:textAllCaps="false"
        android:textColor="@color/color_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>