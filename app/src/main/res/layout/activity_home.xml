<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_dashboard"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/menu_bottom_layout"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/menu_bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/top_rounded_white_solid"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">

        <ImageView
            android:id="@+id/menu_order"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/img_menu_order"
            android:paddingVertical="17dp" />

        <ImageView
            android:id="@+id/menu_home"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_marginHorizontal="22dp"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/img_menu_home_selected"
            android:paddingVertical="17dp" />

        <ImageView
            android:id="@+id/menu_search"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintLeft_toRightOf="@+id/menu_home"
            app:layout_constraintRight_toLeftOf="@+id/menu_order"
            android:layout_marginHorizontal="22dp"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/img_menu_search"
            android:paddingVertical="17dp" />


        <ImageView
            android:id="@+id/menu_updates"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintLeft_toRightOf="@+id/menu_order"
            app:layout_constraintRight_toLeftOf="@+id/menu_profile"
            android:layout_marginHorizontal="22dp"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/img_menu_update"
            android:paddingVertical="17dp" />

        <ImageView
            android:id="@+id/menu_profile"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_marginHorizontal="22dp"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/img_menu_profile"
            android:paddingVertical="17dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>